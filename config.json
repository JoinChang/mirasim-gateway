{
  "searchProvider": "firecrawl",
  "searchLimit": 5,
  "maxConcurrency": 4,
  "cooldownMs": 90000,
  "maxWaitMs": 30000,
  "maxAttempts": 8,
  "retry5xx": 2,
  "retry5xxDelayMs": 500,
  "emitCitations": true,
  "minResultsBeforeFallback": 2,
  "deviceSigning": true,
  "modelAliases": { "gpt-5-codex": "gpt-5.6", "opus": "claude-opus-5", "sonnet": "claude-sonnet-5", "haiku": "claude-haiku-4-5" },
  "defaultModel": "",
  "allowDomains": [
    "wikipedia.org", "arxiv.org", "github.com", "gitlab.com",

    "stackoverflow.com", "stackexchange.com", "serverfault.com", "superuser.com", "askubuntu.com",

    "developer.mozilla.org", "w3.org", "whatwg.org", "rfc-editor.org", "ietf.org", "unicode.org", "caniuse.com",

    "python.org", "typescriptlang.org", "nodejs.org", "deno.com", "bun.sh",
    "rust-lang.org", "docs.rs", "go.dev", "web.dev",

    "npmjs.com", "pypi.org", "crates.io", "rubygems.org", "nuget.org", "hex.pm", "maven.apache.org",

    "learn.microsoft.com", "devblogs.microsoft.com", "developer.apple.com", "developer.android.com",
    "developers.google.com", "cloud.google.com", "ai.google.dev", "docs.aws.amazon.com", "aws.amazon.com",
    "developer.hashicorp.com",

    "kubernetes.io", "docs.docker.com", "nginx.org", "postgresql.org", "sqlite.org", "redis.io", "mongodb.com",

    "archlinux.org", "man7.org", "kernel.org",

    "huggingface.co", "pytorch.org", "tensorflow.org", "scikit-learn.org", "numpy.org", "pandas.pydata.org",

    "anthropic.com", "openai.com", "firecrawl.dev",

    "reuters.com", "apnews.com", "bbc.com",
    "theverge.com", "techcrunch.com", "arstechnica.com", "wired.com"
  ],
  "preferDomains": ["anthropic.com","openai.com","github.com","arxiv.org","wikipedia.org"],
  "blockDomains": ["pinterest.com","tiktok.com","facebook.com","8world.com"]
}

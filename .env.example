MIRASIM_MASTER_KEY=
FIRECRAWL_API_KEY=fc-xxxx
SEARCH_PROVIDER=firecrawl
PORT=8788
BIND_ADDR=127.0.0.1

# Overrides. A value set here wins over docker-compose.yml, so leave them
# commented unless you mean to depart from what the source does.
# MIRASIM_APP_VERSION=0.0.208
# DEVICE_SIGNING=0
# IMAGE_TAG=latest        # or a commit sha, to pin a build
